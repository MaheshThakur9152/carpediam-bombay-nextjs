# Carpediam Bombay Storefront Configuration

# Commerce mode: "mock" (default for offline/tests) or "medusa" (requires backend URL & publishable key)
COMMERCE_MODE=mock

# Medusa v2 Backend Configuration (Required when COMMERCE_MODE=medusa)
MEDUSA_BACKEND_URL=https://api.example.com
MEDUSA_PUBLISHABLE_KEY=pk_test_placeholder

# Public site URL for canonical URLs, sitemap, and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
